{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:widget": "esbuild widget/loader.ts --bundle --minify --format=iife --target=es2019 --outfile=public/widget.js",
    "check:widget": "npm run build:widget && node scripts/check-widget-size.mjs",
    "watch:widget": "esbuild widget/loader.ts --bundle --format=iife --target=es2019 --outfile=public/widget.js --watch",
    "predev": "npm run build:widget",
    "dev": "next dev",
    "prebuild": "npm run build:widget",
    "build": "next build",
    "start": "next start",
    "stand": "node scripts/stand.mjs",
    "lint": "eslint",
    "test:a11y": "playwright test",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts src/lib/*/*.test.ts",
    "fixtures:readiness": "node scripts/readiness-fixtures.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.21.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
