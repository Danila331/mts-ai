      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (table) (increase(eb_retention_deleted_total[1h]))",
          "legendFormat": "{{table}}",
          "range": true
