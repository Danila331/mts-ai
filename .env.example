# OpenAI-совместимый API (организаторов или любой другой для локальной разработки).
# Реальные ключи храните только в .env — он в .gitignore.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Необязательно: отдельные адреса/ключи для эмбеддингов и реранкера.
# EMBEDDER_BASE_URL=
# EMBEDDER_API_KEY=
# RERANKER_BASE_URL=
# RERANKER_API_KEY=

# Ступени поиска и генерации (0 — выключить).
USE_EMBEDDINGS=1
USE_RERANKER=1
DISABLE_THINKING=1
TOP_K=6
MAX_WORKERS=4

# Необязательно: отдельная модель-судья для eval/run_eval.py.
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=
