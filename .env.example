# --- Доступ к модели -------------------------------------------------------
# На платформе эти переменные подставляются автоматически (docs/tech-regulations.md, раздел 6).
# Для локальной разработки — любой OpenAI-совместимый API (например, Qwen3 через OpenRouter).
# Реальные ключи храните только в .env — он в .gitignore.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=qwen/qwen3-reranker-8b

# Необязательно, только локально: отдельные адреса/ключи для эмбеддингов и реранкера.
# EB_EMBEDDER_BASE_URL=
# EMBEDDER_API_KEY=
# EB_RERANKER_BASE_URL=
# RERANKER_API_KEY=

# --- Настройки решения (префикс EB_, чтобы не пересекаться с переменными платформы) ---
EB_TOP_K=10
EB_N_CANDIDATES=20
EB_EXPAND_DOCS=1
EB_CONTEXT_CHARS=18000
EB_EMBED_BATCH=16
EB_MAX_TOKENS=700
EB_TEMPERATURE=0
EB_REQUEST_TIMEOUT=60
EB_USE_EMBEDDINGS=1
EB_USE_RERANKER=1
EB_DISABLE_THINKING=1
# chat_template_kwargs — платформа (vLLM); reasoning — OpenRouter; enable_thinking — DashScope
EB_THINKING_PARAM=chat_template_kwargs
# EB_MAX_WORKERS=4        # по умолчанию берётся MAX_WORKERS платформы, иначе 4
# EB_DEADLINE_SEC=1020    # общий лимит прогона; на платформе тайм-аут 20 минут

# --- Необязательно: отдельная модель-судья для eval/run_eval.py --------------
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=

# --- Стенд: Go-API (backend/) и Python-ядро (scripts/core_api.py) --------------
# Локально (docker compose up) всё работает на умолчаниях. На Railway и Vercel — см. docs/deploy.md.
# EB_CORE_TOKEN=          # общий секрет API и ядра; в docker compose по умолчанию dev-core-token
# EB_API_TOKEN=           # общий секрет прокси Next и API; локально можно не задавать
# EB_ADMIN_TOKEN=         # вход администратора на /settings (Next и API), не короче 32 знаков: «Сохранить» меняет бота для всех.
#                         # Пусто — глобальные настройки закрыты, /settings работает песочницей для своих ответов
# EB_MANAGER_TOKEN=       # доступ к разговорам и заявкам клиентов (GET /api/sessions/:id, экран менеджера);
#                         # пусто — закрыто для всех
# EB_LIMIT_SETTINGS_PER_MINUTE=10  # запросов к настройкам и попыток входа с адреса (EB_LIMIT_SETTINGS_BURST=5)
# EB_WEB_MODE=chat        # режим ответа ядра по умолчанию: chat или eval
# EB_CONFIDENCE_GATE=     # 1 — в режиме chat ниже порога уверенности поиска уточняющий вопрос вместо ответа (T12)
# EB_CONFIDENCE_THRESHOLD=  # порог 0..1, по умолчанию 0.16 (eval/confidence_calibration.py)
# EB_STREAM=              # 0 — ядро не печатает ответ дельтами (T13); по умолчанию 1, режим eval не стримит никогда

# Документы клиента (T9): фото/PDF → текст → клиент проверяет → реплика в чат; отвечает только Qwen.
# Vision-модель — только OCR. Не задана — фото не принимаются, кнопка вложения неактивна.
# EB_VISION_MODEL=        # модель с vision по OpenAI-совместимому API (при make api — напрямую у провайдера)
# EB_VISION_BASE_URL=     # если vision-модель у другого провайдера; пусто — LLM_BASE_URL
# EB_VISION_API_KEY=      # ключ к нему; пусто — LLM_API_KEY
# EB_VISION_TIMEOUT=60s
# EB_OCR_MAX_BYTES=10485760  # предел файла (не больше 32 МБ); на Vercel тело запроса — до 4,5 МБ
# EB_OCR_MAX_PAGES=5      # сколько первых страниц PDF читать (не больше 50)
# EB_LIMIT_OCR_PER_HOUR=30  # документов с адреса в час (EB_LIMIT_OCR_BURST=5)

# Порты на хосте (compose.yaml, только 127.0.0.1); по умолчанию — как ниже.
# EB_WEB_PORT=3000         # стенд и виджет
# EB_API_PORT=8787         # Go-API
# EB_METRICS_PORT=9091     # /metrics API
# EB_PROMETHEUS_PORT=9090  # интерфейс Prometheus
# EB_GRAFANA_PORT=3001     # Grafana (дашборды)
# EB_DB_PORT=5433          # Postgres

# --- Стенд: шлюз к моделям (llm-gateway/, docker compose) -----------------------
# В docker compose ядро и api ходят к модели через шлюз, а шлюз — к провайдеру из LLM_* выше.
# LITELLM_MASTER_KEY=sk-...      # ключ шлюза для ядра и api; в docker compose по умолчанию sk-dev-gateway
# Ключи ядра и api в шлюзе (sk- и не короче 16 знаков); в docker compose есть значения для разработки.
# GW_KEY_CORE=sk-...
# GW_KEY_API=sk-...
# Запасной провайдер той же модели — включается, если заданы все три:
# GW_FALLBACK_BASE_URL=
# GW_FALLBACK_API_KEY=
# GW_FALLBACK_CHAT_MODEL=openai/qwen/qwen3.8-27b
# Vision-модель для распознавания фото документов (T9) у того же провайдера (GW_BASE_URL).
# В docker compose api тогда сам получает EB_VISION_MODEL=energy-vision.
# GW_VISION_MODEL=        # с префиксом протокола LiteLLM: openai/<модель>
# GW_VISION_PRICE_IN=     # цена за миллион токенов, для бюджетов ключей (GW_VISION_PRICE_OUT)

# --- Стенд: Grafana (monitoring/grafana/) -------------------------------------
# Пароль администратора Grafana; без него docker compose не стартует. Придумайте длинный.
# GF_SECURITY_ADMIN_PASSWORD=   # вход в Grafana (admin); не задан — пароль разработки, на хостинге — свой
